---
# Copy to vault.yml, fill in real values, then encrypt:
#   cp vault.yml.example vault.yml && $EDITOR vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
# vault.yml is gitignored — NEVER commit real secrets.
# Run playbooks with --ask-vault-pass (or a vault password file).

# Shared cluster join token. k3s auto-generates one if left unset, but set it
# explicitly so phase-5 agents can join deterministically. Any long random string.
k3s_token: "CHANGE-ME-long-random-string"
