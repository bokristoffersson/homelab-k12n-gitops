# Minecraft (itzg/minecraft-server) config. Rendered via kustomize configMapGenerator
# so any change produces a new hashed ConfigMap name → rolling restart (pods do not
# hot-reload envFrom ConfigMaps; see CLAUDE.md "After ConfigMap updates").
EULA=TRUE
TYPE=PAPER
VERSION=26.2
MEMORY=3G
USE_AIKAR_FLAGS=TRUE
ONLINE_MODE=TRUE
ENABLE_WHITELIST=TRUE
ENFORCE_WHITELIST=TRUE
# Whitelist + operators are managed at RUNTIME via RCON (not committed here — keeps
# player usernames out of git, and only real accounts get added). The server runs
# fine with an enforced-but-empty whitelist; add players once they have valid Java
# accounts:
#   kubectl exec -n minecraft deploy/minecraft -- rcon-cli whitelist add <name>
#   kubectl exec -n minecraft deploy/minecraft -- rcon-cli op <name>
# With WHITELIST/OPS unset, itzg leaves whitelist.json/ops.json (persisted on the
# PVC) alone, so RCON changes survive restarts.
DIFFICULTY=normal
MODE=survival
MOTD=k12n homelab
MAX_PLAYERS=10
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
TZ=Europe/Stockholm
ENABLE_RCON=TRUE
RCON_PORT=25575
OVERRIDE_SERVER_PROPERTIES=TRUE
